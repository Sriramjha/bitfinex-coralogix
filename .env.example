# Bitfinex → API Keys → Create New Key
# Enable Read only (account history / wallets, and Orders read if you collect trades or orders).
# Do not enable Write, Trading, or Withdraw.
# Use this key only on the poller. Nonces are per key and must strictly increase.
BITFINEX_API_KEY=your_bitfinex_api_key
BITFINEX_API_SECRET=your_bitfinex_api_secret

# Authenticated REST host. See https://docs.bitfinex.com/docs/rest-auth
BITFINEX_BASE_URL=https://api.bitfinex.com

# Comma-separated: deposit,withdraw,transfer,trade,order
# Deposits and withdrawals both come from movements history (amount sign).
# Transfers are ledger entries with category 51 (wallet-to-wallet).
# Bitfinex has no official P2P/C2C history endpoint.
BITFINEX_SOURCES=deposit,withdraw,transfer
# Optional. Empty = all symbols for trade/order. Bitfinex symbols start with t (tBTCUSD).
# BITFINEX_SYMBOLS=tBTCUSD,tETHUSD
# Ledger category codes for the transfer source. 51 = transfer.
# BITFINEX_TRANSFER_CATEGORIES=51

# Coralogix Logs API
# Coralogix → Data Flow → API Keys → Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your_coralogix_send_your_data_key
# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com
CORALOGIX_APPLICATION_NAME=bitfinex
CORALOGIX_SUBSYSTEM_NAME=exchange-logs

# Poll last 5 minutes, every 5 minutes
POLL_INTERVAL_SECONDS=300
LOOKBACK_MINUTES=5
STATE_FILE=./state.json
CORALOGIX_BATCH_SIZE=200
HTTP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
